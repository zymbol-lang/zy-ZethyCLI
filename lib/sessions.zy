// Incremental session archive — ~/.ZethyCLI/sessions/YYYY-MM-DD_HH-MM-SS.json
// Written per turn: append_user before the API call, append_assistant after.
// Migrated to std/io + std/json. The home dir is resolved per call (std/io does
// not expand `~`); `date` stays a shell call (CLI utility, not a gap).

# sessions {
    <# std/io   => io
    <# std/json => json

    #> {
        start
        append_user
        append_assistant
        list
    }

    // The current run's session file (set by start()).
    session_file = ""

    // Resolve ~/.ZethyCLI/sessions (std/io does not expand `~`).
    sdir() {
        home = <\ "printenv HOME" \>
        <~ home "/.ZethyCLI/sessions"
    }

    // Create the session file for this run (empty JSON array).
    start() {
        ts  = <\ "date '+%Y-%m-%d_%H-%M-%S'" \>
        dir = sdir()
        _m  = io::mkdir(dir)
        session_file = dir "/" ts ".json"
        _w = io::write(session_file, "[]")
    }

    // Append a {role, content} message to the session archive.
    append_msg(role, content) {
        raw  = io::read(session_file)
        msgs = json::decode(raw)
        msgs = msgs$+ (role: role, content: content)
        _w   = io::write(session_file, json::encode(msgs))
    }

    append_user(content)      { _r = append_msg("user", content) }
    append_assistant(content) { _r = append_msg("assistant", content) }

    // List archived sessions with their message counts.
    list() {
        dir     = sdir()
        entries = io::list(dir)
        ? entries$! { <~ "" }
        out = ""
        @ f : entries {
            path = dir "/" f
            raw  = io::read(path)
            nstr = "?"
            ? (raw$! == #0) {
                arr  = json::decode(raw)
                len  = arr$#
                nstr = "" len
            }
            line = "  " f " (" nstr " messages)\n"
            out  = out line
        }
        <~ out
    }
}
