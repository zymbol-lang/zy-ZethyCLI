// Conversation history — file-based state in {tmp_dir}/msgs.json
// Migrated to the v0.0.7 stdlib: JSON via std/json, file I/O via std/io.
// File-based storage is kept (over module state, G13) because history must
// survive program restarts. The old jq-append + shell-quoting workarounds are
// gone: messages are passed as plain strings and json::encode handles escaping.

# history {
    <# std/io   => io
    <# std/json => json

    #> {
        init
        add_user
        add_user_from_file
        add_assistant
        get_msgs_file
        get_count
        clear
        set_tmp_dir
    }

    // Private mutable paths — updated by set_tmp_dir()
    msgs_file  = "/tmp/ZethyCLI/msgs.json"
    count_file = "/tmp/ZethyCLI/count.txt"

    set_tmp_dir(dir) {
        msgs_file  = dir "/msgs.json"
        count_file = dir "/count.txt"
    }

    get_msgs_file() { <~ msgs_file }

    get_count() {
        raw = io::read(count_file)
        ? raw$! { <~ 0 }
        <~ #|raw$~~["\n":""]|
    }

    // Append a {role, content} message and bump the turn count. Private helper.
    append_msg(role, content) {
        raw   = io::read(msgs_file)
        msgs  = json::decode(raw)
        msgs  = msgs$+ #(role: role, content: content)
        _w    = io::write(msgs_file, json::encode(msgs))
        n     = get_count()
        new_n = n + 1
        cs    = "" new_n
        _c    = io::write(count_file, cs)
    }

    // Initialize conversation with a system prompt and optional memory context.
    init(system_prompt, mem_ctx) {
        full_prompt = system_prompt
        ? (mem_ctx <> "") {
            full_prompt = system_prompt "\n\nMemory from previous sessions:\n" mem_ctx
        }
        msgs = [ #(role: "system", content: full_prompt) ]
        _w = io::write(msgs_file, json::encode(msgs))
        _c = io::write(count_file, "1")
    }

    add_user(raw_content) {
        _r = append_msg("user", raw_content)
    }

    // Append a user message built from a file's content (for /file).
    add_user_from_file(label, content_file) {
        file_content = io::read(content_file)
        ? file_content$! { file_content = "(could not read file)" }
        body = "File: " label "\n```\n" file_content "\n```"
        _r = append_msg("user", body)
    }

    add_assistant(raw_content) {
        _r = append_msg("assistant", raw_content)
    }

    clear() {
        _m = io::delete(msgs_file)
        _c = io::delete(count_file)
    }
}
