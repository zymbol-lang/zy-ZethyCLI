// Ollama API client — local provider.
// Migrated to the v0.0.7 standard library: HTTP via std/net (G1), JSON via
// std/json (G2), file reads via std/io (G3). The only remaining BashExec calls
// query the `ollama` CLI itself (install check, model list) — that is legitimate
// command use, not a language gap.
// host_base, tmp_dir are private mutable state — updated by setters.

# ollama {
    <# std/net  => net
    <# std/json => json
    <# std/io   => io

    #> {
        chat
        summarize
        models
        is_running
        is_installed
        model_exists
        supports_think
        set_host
        get_host
    }

    host_base = "http://localhost:11434"

    // Change Ollama host. Accepts "192.168.1.1", "192.168.1.1:9999", or "http://..."
    // No port → :11434 appended automatically
    set_host(addr) {
        proto_pos = addr$?? "://"
        ? (proto_pos$# == 0) {
            colon_pos = addr$?? ":"
            ? (colon_pos$# == 0) {
                host_base = "http://" $++ addr ":11434"
            } _ {
                host_base = "http://" $++ addr
            }
        } _ {
            host_base = addr
        }
    }

    get_host() { <~ host_base }

    // Query /api/show and report whether the model lists a "thinking" capability.
    // Returns #0 on any network/API error. (String-scan avoids decoding an error
    // response shape that would lack the capabilities field.)
    supports_think(model) {
        url  = host_base "/api/show"
        body = json::encode((model: model))
        raw  = net::post_json(url, body)
        ? raw$! { <~ #0 }
        <~ ((raw$?? "thinking")$# > 0)
    }

    // Send a chat request; returns the assistant response text.
    // `think` is a Zymbol bool → encoded directly as a JSON boolean.
    chat(model, msgs_file, think) {
        url      = host_base "/api/chat"
        raw_msgs = io::read(msgs_file)
        msgs     = json::decode(raw_msgs)
        req      = (model: model, messages: msgs, stream: #0, think: think)
        raw      = net::post_json(url, json::encode(req))
        ? raw$! {
            <~ "[network error] Ollama request failed — is the daemon running?"
        }
        has_msg = (raw$?? "message")$# > 0
        ? has_msg {
            resp = json::decode(raw)
            <~ resp.message.content
        }
        <~ "[error] Ollama: " raw
    }

    // Summarize the conversation; returns the summary text.
    summarize(model, msgs_file) {
        url      = host_base "/api/chat"
        raw_msgs = io::read(msgs_file)
        msgs     = json::decode(raw_msgs)
        instr    = (role: "user", content: "Summarize this conversation in 3 to 5 concise bullet points. Focus on key topics, decisions, and facts about the user. Be brief.")
        msgs     = msgs$+ instr
        req      = (model: model, messages: msgs, stream: #0)
        raw      = net::post_json(url, json::encode(req))
        ? raw$! {
            <~ "(summary unavailable — network error)"
        }
        has_msg = (raw$?? "message")$# > 0
        ? has_msg {
            resp = json::decode(raw)
            <~ resp.message.content
        }
        <~ "(summary unavailable)"
    }

    // List available models as a comma-separated string.
    models() {
        url = host_base "/api/tags"
        raw = net::get(url)
        ? raw$! { <~ "" }
        resp = json::decode(raw)
        out  = ""
        @ m : resp.models {
            ? (out == "") {
                out = m.name
            } _ {
                out = out ", " m.name
            }
        }
        <~ out
    }

    // Check if the `ollama` binary is available in PATH (CLI check — not a gap).
    is_installed() {
        result = <\ "command -v ollama > /dev/null 2>&1 && echo 1 || echo 0" \>
        <~ (result$~~["\n":""] == "1")
    }

    // Check if a specific model name exists in `ollama list` (CLI check — not a gap).
    model_exists(name) {
        result = <\ "ollama list 2>/dev/null | tail -n +2 | awk '\{print $1\}' | grep -qx '" name "' && echo 1 || echo 0" \>
        <~ (result$~~["\n":""] == "1")
    }

    // Check if the Ollama HTTP service is reachable (200 on GET / ).
    is_running() {
        root_url = host_base "/"
        raw = net::get(root_url)
        <~ (raw$! == #0)
    }
}
