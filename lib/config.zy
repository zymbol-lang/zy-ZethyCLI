// Persistent configuration — ~/.ZethyCLI/ZethyCLI.conf (JSON)
// Loaded once at startup; saved on every /model, /mode, /host command.
// tmp_dir is only applied at startup — change it by editing the config file directly.
//
// Migrated to the v0.0.7 stdlib on 2026-10-21 (G4): read with std/io + std/json
// instead of seven `jq` calls, written with json::encode instead of a `jq -n`
// command line. That command line pasted every value between single quotes, so
// an API key, host or path holding a `'` broke it — the shell-safety gap G4
// names. A field missing from the file, or `null`, keeps its default, as
// `jq -r '.x // empty'` did; a number is read as its text.

# config {
    <# std/io   => io
    <# std/json => json

    #> {
        load
        save
        get_model
        get_mode
        get_think
        get_host
        get_tmp_dir
        get_provider
        get_api_key
        set_provider
        set_api_key
    }

    cfg_model    = ""
    cfg_mode     = "fast"
    cfg_think    = #0
    cfg_host     = "http://localhost:11434"
    cfg_tmp_dir  = "/tmp/ZethyCLI"
    // provider: "ollama" (local) or "gemini" (external web API with api_key)
    cfg_provider = "ollama"
    cfg_api_key  = ""

    // ~/.ZethyCLI — std/io does not expand `~`, and module variables must be
    // literals, so the home dir is looked up per call (as memory.zy does).
    conf_dir() {
        home = <\ "printenv HOME" \>
        <~ home "/.ZethyCLI"
    }

    // A field of the decoded config as text: "" when it is absent or null.
    field(cfg, key) {
        ? cfg$? key { <~ "" cfg[key] }
        <~ ""
    }

    load() {
        dir  = conf_dir()
        _m   = io::mkdir(dir)
        file = dir "/ZethyCLI.conf"
        ? io::exists(file) {
            raw = io::read(file)
            cfg = json::decode(raw)
            // An unreadable file, malformed JSON or anything but an object
            // leaves every default in place.
            ? !raw$! && !cfg$! && (cfg#?)[1] == "##(" {
                m = field(cfg, "model")
                ? (m <> "") { cfg_model = m }

                o = field(cfg, "mode")
                ? (o <> "") { cfg_mode = o }

                // `think` is written as a JSON boolean; "true" as text is read too.
                t = field(cfg, "think")
                ? (t == "#1" || t == "true") { cfg_think = #1 }

                h = field(cfg, "host")
                ? (h <> "") { cfg_host = h }

                d = field(cfg, "tmp_dir")
                ? (d <> "") { cfg_tmp_dir = d }

                pv = field(cfg, "provider")
                ? (pv <> "") { cfg_provider = pv }

                k = field(cfg, "api_key")
                ? (k <> "") { cfg_api_key = k }
            }
        }
        // Ensure tmp dir exists on every startup
        _t = io::mkdir(cfg_tmp_dir)
    }

    // Persist current session config to disk.
    // provider + api_key come from module state (set via set_provider/set_api_key).
    save(model, mode, think, host, tmp_dir) {
        cfg = #(
            model: model,
            mode: mode,
            think: think,
            host: host,
            tmp_dir: tmp_dir,
            provider: cfg_provider,
            api_key: cfg_api_key
        )
        _w = io::write(conf_dir() "/ZethyCLI.conf", json::encode(cfg))
    }

    get_model()    { <~ cfg_model    }
    get_mode()     { <~ cfg_mode     }
    get_think()    { <~ cfg_think    }
    get_host()     { <~ cfg_host     }
    get_tmp_dir()  { <~ cfg_tmp_dir  }
    get_provider() { <~ cfg_provider }
    get_api_key()  { <~ cfg_api_key  }

    set_provider(p) { cfg_provider = p }
    set_api_key(k)  { cfg_api_key  = k }
}
