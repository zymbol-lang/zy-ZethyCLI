// Cross-session persistent memory — ~/.ZethyCLI/memory.txt
// Stores user-defined facts (/remember) and auto-generated session summaries (/exit).
// Injected into the system prompt at startup so the model always has context.
// Migrated to std/io. The home directory is resolved once via the shell channel
// (printenv HOME) because std/io does not expand `~`; `date` stays a shell call
// (a CLI utility, not a language gap).

# memory {
    <# std/io => io

    #> {
        get_context
        save_fact
        save_summary
        clear
    }

    // Resolve ~/.ZethyCLI/memory.txt — std/io does not expand `~`, and module
    // variables must be literals, so the home dir is looked up per call.
    mem_path() {
        home = <\ "printenv HOME" \>
        <~ home "/.ZethyCLI/memory.txt"
    }

    // Returns full memory.txt content, or "" if it does not exist yet.
    get_context() {
        raw = io::read(mem_path())
        ? raw$! { <~ "" }
        <~ raw
    }

    // Append a user-defined fact as a bullet point.
    save_fact(fact) {
        line = "\n- " fact
        mf = mem_path()
        _w = io::append(mf, line)
    }

    // Append a dated summary block. Takes the summary TEXT directly (std/json/io
    // removed the old content-file handoff that worked around shell quoting).
    save_summary(text) {
        date_str = <\ "date '+%Y-%m-%d %H:%M'" \>
        block = "\n[" date_str "]\n" text "\n"
        mf = mem_path()
        _w = io::append(mf, block)
    }

    // Erase all memory. Called by /forget.
    clear() {
        _d = io::delete(mem_path())
    }
}
